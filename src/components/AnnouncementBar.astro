---
const announcements = [
    "One Product For One Person",
    "Handmade dari limbah kayu jati",
    "Sejak 2017, Kemiri Barat, Batang",
];
---

<div
    class="relative z-[1010] flex h-9 items-center justify-center border-b border-wabi-stone bg-wabi-linen text-wabi-char"
    role="region"
    aria-label="Informasi singkat brand"
>
    <div class="relative flex h-full w-full max-w-[1420px] items-center justify-center px-4">
        {announcements.map((text, idx) => (
            <p
                data-announcement
                class:list={[
                    "absolute m-0 text-center text-[11.5px] uppercase tracking-[0.18em] transition-all duration-500 ease-luxury",
                    idx === 0
                        ? "translate-y-0 opacity-100"
                        : "pointer-events-none translate-y-1.5 opacity-0",
                ]}
            >
                {text}
            </p>
        ))}
    </div>
</div>

<!-- ISI DARI ADMIN: opsi versi bahasa Inggris akan ditambahkan setelah konten terjemahan terkonfirmasi -->

<script>
    const items = document.querySelectorAll("[data-announcement]");
    const reduced = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
    ).matches;

    if (items.length > 1 && !reduced) {
        let current = 0;
        setInterval(() => {
            items[current].classList.remove("opacity-100", "translate-y-0");
            items[current].classList.add(
                "opacity-0",
                "translate-y-1.5",
                "pointer-events-none",
            );
            current = (current + 1) % items.length;
            items[current].classList.remove(
                "opacity-0",
                "translate-y-1.5",
                "pointer-events-none",
            );
            items[current].classList.add("opacity-100", "translate-y-0");
        }, 4200);
    }
</script>
