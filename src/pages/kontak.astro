---
import BaseLayout from "../layouts/BaseLayout.astro";
import {
    BRAND_INFO,
    WHATSAPP_NUMBER,
    buildWhatsAppUrl,
} from "../data/products.js";

const waConsultUrl = buildWhatsAppUrl(
    "Halo Bjo Furface, saya ingin berkonsultasi mengenai produk.",
);
---

<BaseLayout
    title="Kontak & Lokasi — Bjo Furface | Kemiri Barat, Subah, Batang"
    description="Hubungi Bjo Furface melalui WhatsApp, Instagram, Shopee, atau kunjungi workshop kami di Desa Kemiri Barat, Kecamatan Subah, Kabupaten Batang."
>
    <!-- Editorial Banner -->
    <section class="border-b border-wabi-stone bg-wabi-linen py-16 lg:py-24">
        <div class="mx-auto grid max-w-[1420px] grid-cols-1 items-end gap-8 px-5 sm:px-8 lg:grid-cols-[1.15fr_0.85fr] lg:px-12">
            <div>
                <span class="mb-3 block text-[11.5px] font-medium uppercase tracking-[0.22em] text-wabi-brass">
                    Hubungi Kami
                </span>
                <h1 class="font-serif text-[40px] font-normal leading-[1.1] sm:text-[50px] lg:text-[56px]">
                    Kontak &amp; Workshop
                </h1>
            </div>
            <p class="font-serif text-[20px] leading-relaxed text-wabi-char lg:text-[23px]">
                Silakan hubungi admin Bjo Furface untuk menanyakan ketersediaan
                motif kayu jati, detail ukuran produk, maupun kunjungan ke
                workshop kami di Batang.
            </p>
        </div>
    </section>

    <!-- Kontak 2 Kolom -->
    <section class="py-20 lg:py-28" aria-labelledby="heading-contact-details">
        <div class="mx-auto grid max-w-[1420px] grid-cols-1 items-start gap-12 px-5 sm:px-8 lg:grid-cols-2 lg:gap-20 lg:px-12">
            <div class="reveal">
                <div
                    class="mb-6 h-px w-12 bg-wabi-brass"
                    aria-hidden="true"
                ></div>
                <h2
                    id="heading-contact-details"
                    class="font-serif text-[36px] font-normal leading-tight lg:text-[44px]"
                >
                    Informasi Resmi
                </h2>

                <div class="mt-8 border-b border-wabi-stone pb-6">
                    <h3 class="mb-2 text-[11.5px] font-medium uppercase tracking-[0.18em] text-wabi-brass">
                        Alamat Workshop
                    </h3>
                    <address class="text-[16px] not-italic leading-relaxed text-wabi-char">
                        {BRAND_INFO.address}
                    </address>
                </div>

                <div class="mt-6 border-b border-wabi-stone pb-6">
                    <h3 class="mb-2 text-[11.5px] font-medium uppercase tracking-[0.18em] text-wabi-brass">
                        Jam Operasional
                    </h3>
                    <!-- ISI DARI ADMIN: jadwal buka dan tutup workshop Bjo Furface -->
                    <p class="text-[16px] text-wabi-bark">[MENUNGGU DATA]</p>
                </div>

                <div class="mt-6 border-b border-wabi-stone pb-6">
                    <h3 class="mb-3 text-[11.5px] font-medium uppercase tracking-[0.18em] text-wabi-brass">
                        Kanal Resmi &amp; Marketplace
                    </h3>
                    <ul class="flex flex-col gap-3 text-[14.5px]">
                        <li>
                            <a
                                href={BRAND_INFO.instagramMain}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="inline-flex items-center gap-1.5 border-b border-wabi-stone pb-0.5 font-medium transition-colors hover:border-wabi-brass hover:text-wabi-brass"
                            >
                                Instagram Utama: @bjofurface &#8599;
                            </a>
                        </li>
                        <li>
                            <a
                                href={BRAND_INFO.instagramFashion}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="inline-flex items-center gap-1.5 border-b border-wabi-stone pb-0.5 font-medium transition-colors hover:border-wabi-brass hover:text-wabi-brass"
                            >
                                Instagram Fashion: @bjofurface_fashion &#8599;
                            </a>
                        </li>
                        <li>
                            <a
                                href={BRAND_INFO.shopeeUrl}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="inline-flex items-center gap-1.5 border-b border-wabi-stone pb-0.5 font-medium transition-colors hover:border-wabi-brass hover:text-wabi-brass"
                            >
                                Official Store Shopee: shopee.co.id/bjofurface
                                &#8599;
                            </a>
                        </li>
                    </ul>
                </div>

                <div class="mt-9">
                    <!-- GANTI: nomor WA resmi dari admin -->
                    <a
                        href={waConsultUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center justify-center rounded-full bg-wabi-char px-8 py-4 text-[14px] font-medium tracking-[0.08em] text-wabi-paper transition-colors hover:bg-wabi-walnut"
                    >
                        Chat Langsung via WhatsApp
                    </a>
                </div>
            </div>

            <!-- Formulir Pesan Otomatis ke WhatsApp -->
            <div class="reveal rounded-[6px] border border-wabi-stone bg-wabi-linen p-7 sm:p-11">
                <h2 class="font-serif text-[32px] font-normal leading-tight">
                    Kirim Pesan ke WhatsApp
                </h2>
                <p class="mt-2 mb-7 text-[14.5px] leading-relaxed text-wabi-bark">
                    Isi nama dan pertanyaan Anda di bawah ini. Saat dikirim,
                    pesan akan otomatis terbuka di aplikasi WhatsApp.
                </p>

                <!-- GANTI: nomor WA resmi dari admin -->
                <form
                    id="whatsapp-contact-form"
                    data-wa-number={WHATSAPP_NUMBER}
                    novalidate
                >
                    <div class="mb-5">
                        <label
                            for="sender-name"
                            class="mb-2 block text-[12px] font-medium uppercase tracking-[0.14em] text-wabi-char"
                        >
                            Nama Anda
                        </label>
                        <input
                            type="text"
                            id="sender-name"
                            name="name"
                            placeholder="Masukkan nama Anda"
                            required
                            class="w-full rounded-[6px] border border-wabi-stone bg-wabi-paper px-4 py-3 text-[15px] text-wabi-char"
                        />
                    </div>

                    <div class="mb-5">
                        <label
                            for="sender-message"
                            class="mb-2 block text-[12px] font-medium uppercase tracking-[0.14em] text-wabi-char"
                        >
                            Pesan / Pertanyaan
                        </label>
                        <textarea
                            id="sender-message"
                            name="message"
                            rows="5"
                            placeholder="Contoh: Halo, saya ingin menanyakan stok motif Pemba Abstrack atau Penampan Island ukuran M."
                            required
                            class="w-full rounded-[6px] border border-wabi-stone bg-wabi-paper px-4 py-3 text-[15px] text-wabi-char"
                        ></textarea>
                    </div>

                    <p
                        id="form-error"
                        role="alert"
                        hidden
                        class="mb-4 text-[13.5px] text-red-800"
                    ></p>

                    <button
                        type="submit"
                        class="w-full rounded-full bg-wabi-char px-6 py-3.5 text-[14px] font-medium tracking-[0.08em] text-wabi-paper transition-colors hover:bg-wabi-walnut"
                    >
                        Lanjutkan ke WhatsApp &#8594;
                    </button>
                </form>
            </div>
        </div>
    </section>
</BaseLayout>

<script>
    const form = document.getElementById(
        "whatsapp-contact-form",
    ) as HTMLFormElement | null;
    const nameInput = document.getElementById(
        "sender-name",
    ) as HTMLInputElement | null;
    const msgInput = document.getElementById(
        "sender-message",
    ) as HTMLTextAreaElement | null;
    const errorEl = document.getElementById("form-error");

    form?.addEventListener("submit", (e) => {
        e.preventDefault();
        if (!nameInput || !msgInput || !errorEl) return;

        const name = nameInput.value.trim();
        const message = msgInput.value.trim();
        const waNumber = form.dataset.waNumber || "6280000000000";

        if (!name || !message) {
            errorEl.textContent =
                "Mohon isi nama dan pesan Anda terlebih dahulu sebelum mengirim ke WhatsApp.";
            errorEl.hidden = false;
            if (!name) nameInput.focus();
            else msgInput.focus();
            return;
        }

        errorEl.hidden = true;
        const text = `Halo Bjo Furface, perkenalkan saya ${name}.\n\n${message}`;
        window.open(
            `https://wa.me/${waNumber}?text=${encodeURIComponent(text)}`,
            "_blank",
            "noopener,noreferrer",
        );
    });
</script>
